---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, LINKS, GOATCOUNTER_CODE } from '../consts';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const nav = [
  { href: url('/blog/'), label: '記事' },
  { href: url('/tags/'), label: 'タグ' },
  { href: url('/about/'), label: '自己紹介' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <!-- SNS でシェアされたときの表示 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('/og-image.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- 訪問者カウンター（GoatCounter） -->
    {
      GOATCOUNTER_CODE && (
        <script
          is:inline
          data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url('/')} aria-label={`${SITE_TITLE} トップへ`}>
          <img src={url('/logo.svg')} alt="" width="44" height="44" />
        </a>
        <nav aria-label="メインメニュー">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          © {year} {AUTHOR_NAME}
          <span class="visits" id="visits" data-code={GOATCOUNTER_CODE} hidden>
            ・累計 <span></span> 人が訪問
          </span>
        </p>
        <ul>
          {LINKS.linkedin && (
            <li>
              <a href={LINKS.linkedin} rel="me noopener">LinkedIn</a>
            </li>
          )}
          {LINKS.github && (
            <li>
              <a href={LINKS.github} rel="me noopener">GitHub</a>
            </li>
          )}
        </ul>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const el = document.getElementById('visits');
        if (!el || !el.dataset.code) return;
        fetch(`https://${el.dataset.code}.goatcounter.com/counter/TOTAL.json`)
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d) return;
            el.querySelector('span').textContent = d.count;
            el.hidden = false;
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  nav ul,
  .footer-inner ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.25rem 0;
  }
  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--amber);
  }
  main {
    padding: 2.5rem 0 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }
  .footer-inner p {
    margin: 0;
  }
  .brand img {
    display: block;
  }
</style>
