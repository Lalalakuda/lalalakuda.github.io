---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url, formatDate } from '../../utils';

export async function getStaticPaths() {
  // 新しい順に並べて、前後の記事を決める
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="wrap">
    <header class="post-header">
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>（更新 {formatDate(updatedDate)}）</span>}
      </p>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="タグ">
            {tags.map((tag) => (
              <li>
                <a href={url(`/tags/${tag}/`)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      {
        (older || newer) && (
          <nav class="pager" aria-label="前後の記事">
            {older ? (
              <a class="pager-link prev" href={url(`/blog/${older.id}/`)}>
                <span class="pager-label">前の記事</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="pager-link next" href={url(`/blog/${newer.id}/`)}>
                <span class="pager-label">次の記事</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
      <a class="back" href={url('/blog/')}>記事一覧へ戻る</a>
    </footer>
  </article>
</BaseLayout>
<script>
  // 記事内の写真の説明文を、写真の下にキャプションとして表示する
  document.querySelectorAll('.prose img[alt]').forEach((img) => {
    const text = img.getAttribute('alt');
    if (!text || img.closest('figure')) return;
    const fig = document.createElement('figure');
    fig.className = 'photo';
    const cap = document.createElement('figcaption');
    cap.textContent = text;
    const p = img.parentElement;
    if (p && p.tagName === 'P' && p.childNodes.length === 1) {
      p.replaceWith(fig);
    } else {
      img.before(fig);
    }
    fig.append(img, cap);
  });
</script>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }
  .meta {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    line-height: 1.4;
    margin: 0;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .tags a {
    display: inline-block;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }
  .tags a:hover {
    border-color: var(--amber);
    color: var(--ink);
  }
  .post-footer {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
  }
  .pager-link:hover {
    border-color: var(--amber);
  }
  .next {
    text-align: right;
  }
  .pager-label {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pager-title {
    font-weight: 700;
    line-height: 1.5;
  }
  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager > span:empty {
      display: none;
    }
  }
</style>
